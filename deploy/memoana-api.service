[Unit]
Description=MemoAna API Docker container
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=0

ExecStartPre=-/usr/bin/docker rm -f memoana-api
ExecStartPre=/bin/sh -c '/usr/bin/docker network inspect memoana-network >/dev/null 2>&1 || /usr/bin/docker network create memoana-network'
ExecStartPre=/usr/bin/docker pull ghcr.io/thememoanagame/memoana-api:v0.0.1-rc1
ExecStart=/usr/bin/docker run --name memoana-api --network memoana-network --publish 127.0.0.1:7080:7080 --volume /data/memoana-api:/data ghcr.io/thememoanagame/memoana-api:v0.0.1-rc1
ExecStop=/usr/bin/docker stop memoana-api

[Install]
WantedBy=multi-user.target
