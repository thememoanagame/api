[Unit]
Description=MemoAna API Docker container
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=0

ExecStartPre=-/usr/bin/docker rm -f memoana-api
ExecStartPre=/usr/bin/docker pull ghcr.io/thememoanagame/memoana-api:v0.0.1-rc1
ExecStart=/usr/bin/docker run --name memoana-api --publish 8080:8080 --volume /data/memoana-api:/data ghcr.io/thememoanagame/memoana-api:v0.0.1-rc1
ExecStop=/usr/bin/docker stop memoana-api

[Install]
WantedBy=multi-user.target
